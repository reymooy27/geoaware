# GeoAware Environment Variables

# Application
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geoaware?schema=public

# Frontend URL (for CORS)
CORS_ORIGIN=http://localhost:3000

# Mapbox (Required for map rendering)
MAPBOX_TOKEN=your_mapbox_access_token_here
VITE_MAPBOX_TOKEN=your_mapbox_access_token_here

# Earthquake Data Sources
BMKG_API_URL=https://data.bmkg.go.id/gempadirasakan.xml
USGS_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson

# Firebase (for Push Notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# Twilio (for SMS Notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Business API (for WhatsApp Notifications)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/your_phone_number_id
WHATSAPP_API_TOKEN=your_whatsapp_business_token