{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geoaware",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "triggers": {
    "crons": ["*/5 * * * *", "0 * * * *"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "71fdf946b7ff43ab913ab31f3ae01c35",
      "localConnectionString": "postgresql://postgres.yqwcodxrouaahuhgvcdj:TPOOX1tfnNbKPzbf@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
    }
  ],
  "observability": {
    "enabled": true
  }
}
